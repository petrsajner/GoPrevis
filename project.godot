; GenPrevis standalone prototype. Open with Godot 4.7.2 .NET.
config_version=5

[application]
config/name="GenPrevis"
config/version="0.15.0"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://assets/genprevis.png"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1100
window/size/min_height=700
window/size/mode=2
window/stretch/mode="disabled"

[dotnet]
project/assembly_name="GenPrevis"

[internationalization]
locale/fallback="en"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.035,0.042,1)

[gui]
theme/default_font_multichannel_signed_distance_field=true
